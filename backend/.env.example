# ShelfLife Backend — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to Git.

PORT=5000
NODE_ENV=development

# MongoDB connection URI (use MongoDB Atlas for production)
MONGODB_URI=mongodb://localhost:27017/shelflife

# JWT secret — change this to a long random string in production
JWT_SECRET=your_jwt_secret_here

# Librarian login credentials (change in production)
LIBRARIAN_EMAIL=librarian@example.com
LIBRARIAN_PASSWORD=your_secure_password_here
